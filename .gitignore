# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Runtime/debug/cache artifacts
data/_cache/
data/_debug/
data/logs/
data/_sharp_dump_*.html
previous_state/
logs/
external/

# Generated pipeline tables. These are rebuilt by Full Slate and uploaded as
# workflow artifacts; they are not source code and must not become stale inputs.
data/*.csv
outputs/*.csv
outputs/**/*.csv
outputs/**/*.parquet
outputs/**/*.json

# Keep intentional static schedules/model calibration/weather metadata.
!data/schedules/
!data/schedules/**
!data/model_ensemble_weights.csv
!data/stadiums.csv
!data/*.json

# ...but a run-status JSON is regenerated by every pricing run and every test
# run, and its values describe that run only. Committing one would leave a
# stale status file on disk that validators read as authority.
data/player_scoring_td_prior_status.json

# Local tooling
.DS_Store
*.log
