data/*.csv
outputs/*.csv
outputs/**/*.csv
outputs/**/*.parquet
outputs/**/*.json

# Keep intentional static fixtures/schedules/model calibration files if added.
!data/schedules/
!data/schedules/**
!data/*.json

# Local tooling
.DS_Store
*.log
