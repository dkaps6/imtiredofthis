{
  "contract_version": "PLAYER_ROLE_ENVIRONMENT_EVIDENCE_V1",
  "status": "FROZEN_EVIDENCE_SCHEMA_SOURCE_ENGINEERING_ONLY",
  "created_date": "2026-09-17",
  "grain": "player_team_target_game",
  "target_positions": [
    "QB",
    "RB",
    "WR",
    "TE"
  ],
  "purpose": "Represent current football role/environment evidence without directly assigning projected stats.",
  "global_rules": [
    "All evidence must be available before target kickoff.",
    "Sportsbook data is prohibited.",
    "Target-game partial usage is prohibited.",
    "Depth chart is contextual evidence only and cannot directly determine opportunity.",
    "Qualitative statements are structured evidence and cannot directly add carries, targets, receptions, or yards.",
    "Current certified availability/eligible-role artifacts remain authoritative for who is available; this layer does not override them.",
    "Unknown evidence must remain null/abstain rather than fabricated.",
    "Any eventual regime-state classifier is deterministic evidence synthesis before predictive coefficients are tested."
  ],
  "source_registry": {
    "CURRENT_AVAILABILITY": {
      "status": "QUALIFIED_CURRENT_PRODUCTION_AUTHORITY",
      "artifacts": [
        "data/current_player_availability.csv",
        "data/roles_current_production_eligible_v1.csv"
      ],
      "lineage": [
        "Ourlads current depth/status",
        "weekly injury evidence",
        "official game-day inactive evidence",
        "T-75 timing certification"
      ],
      "temporal_rule": "snapshot and certification must be valid before target kickoff"
    },
    "STRICT_PRIOR_PLAYER_HISTORY": {
      "status": "QUALIFIED_CURRENT_PRODUCTION_STRICT_PRIOR",
      "artifacts": [
        "data/player_game_logs.csv",
        "data/player_form_consensus.csv"
      ],
      "temporal_rule": "active-season game log week must be strictly less than target week"
    },
    "HISTORICAL_ROSTER_TEAM_HISTORY": {
      "status": "AVAILABLE_NEEDS_REGIME_ENGINEERING",
      "lineage": [
        "nflverse weekly rosters",
        "historical player/team game logs",
        "stable player identity bridge"
      ],
      "temporal_rule": "only roster/team facts established before target kickoff"
    },
    "CURRENT_DEPTH_CONTEXT": {
      "status": "QUALIFIED_CURRENT_CONTEXT",
      "lineage": [
        "Ourlads depth/status"
      ],
      "temporal_rule": "timestamped pre-kickoff snapshot",
      "limitation": "WR LWR/RWR/SWR depth lanes are not a unique WR1/WR2 hierarchy"
    },
    "COACH_PLAYCALLER_HISTORY": {
      "status": "SOURCE_CONTRACT_REQUIRED",
      "limitation": "No production-qualified historical/current coaching-change contract frozen yet."
    },
    "AUTHORITATIVE_ROLE_STATEMENT": {
      "status": "FORWARD_ARCHIVE_REQUIRED",
      "allowed_source_tiers": [
        "official team/NFL transaction or depth information",
        "official coach/GM/player transcript",
        "official team editorial/reporting",
        "NFL.com directly attributed reporting",
        "separately approved high-quality reporting"
      ],
      "temporal_rule": "publication timestamp < target kickoff",
      "limitation": "statement is evidence only, never a direct numerical projection adjustment"
    },
    "TRANSACTION_EVENT_HISTORY": {
      "status": "SOURCE_CONTRACT_REQUIRED_OR_DERIVABLE_WITH_AUDIT",
      "temporal_rule": "transaction must be established before target kickoff"
    },
    "CURRENT_TRENCH_PERSONNEL": {
      "status": "PARTIAL_CURRENT_CONTEXT_AVAILABLE",
      "lineage": [
        "current depth/status",
        "current availability",
        "strict-prior snap/pass-rush history where qualified"
      ],
      "limitation": "does not provide exact target-game blocker-rusher assignment"
    }
  },
